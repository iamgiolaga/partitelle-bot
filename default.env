# Template for the local .env file: cp default.env .env
# `.env` is NOT loaded by the code; run the bot with `uv run --env-file .env ...`
ENV=local
PB_TG_TOKEN=
PB_URL=
# Optional: webhook secret (ENV != local only), derived from PB_TG_TOKEN when unset
# PB_WEBHOOK_SECRET=
PB_DB_SCHEMA=staging
PB_DB_HOST=localhost
PB_DB_NAME=partitelle
PB_DB_USER=partitelle
PB_DB_PASSWORD=partitelle
PB_DB_PORT=5432
